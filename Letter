<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Letter For Tessa ❤️</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Cormorant Garamond & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        serif: ['"Cormorant Garamond"', 'serif'],
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        love: {
                            900: '#120c10',
                            800: '#1f141b',
                            700: '#2d1c27',
                            600: '#4a2b3d',
                            accent: '#e0567a',
                            gold: '#dfb15b',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #0b070a;
            color: #f3e8ee;
            overflow-x: hidden;
        }
        .serif-font {
            font-family: 'Cormorant Garamond', serif;
        }
        /* Floating hearts particle styling */
        @keyframes floatUp {
            0% {
                transform: translateY(100vh) scale(0.6) rotate(0deg);
                opacity: 0;
            }
            20% {
                opacity: 0.8;
            }
            80% {
                opacity: 0.8;
            }
            100% {
                transform: translateY(-10vh) scale(1.2) rotate(360deg);
                opacity: 0;
            }
        }
        .particle {
            position: fixed;
            bottom: -20px;
            pointer-events: none;
            animation: floatUp linear infinite;
            z-index: 1;
        }
        /* Envelope animation styles */
        .envelope-wrapper {
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .envelope-flap {
            transition: transform 0.6s ease;
            transform-origin: top;
        }
        .envelope-open .envelope-flap {
            transform: rotateX(180deg);
            z-index: 10;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #120c10;
        }
        ::-webkit-scrollbar-thumb {
            background: #4a2b3d;
            border-radius: 3px;
        }
        .glow-box {
            box-shadow: 0 0 40px -10px rgba(224, 86, 122, 0.25);
        }
    </style>
</head>
<body class="h-full flex flex-col justify-between items-center relative selection:bg-rose-500 selection:text-white">

    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-rose-950/30 via-love-900 to-black pointer-events-none -z-10"></div>
    <div id="particles-container" class="absolute inset-0 overflow-hidden pointer-events-none z-0"></div>

    <header class="w-full pt-8 pb-4 px-6 text-center z-10">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-love-700/50 border border-rose-500/30 text-rose-300 text-xs tracking-widest uppercase mb-2 backdrop-blur-md shadow-sm">
            <i class="fa-solid fa-heart text-rose-400 animate-pulse"></i> Digital Love Note
        </div>
        <h1 class="serif-font text-4xl sm:text-5xl font-semibold tracking-wide text-rose-100 drop-shadow-md">
            Letter For Tessa <span class="text-rose-500 inline-block animate-bounce">❤️</span>
        </h1>
    </header>

    <main class="w-full max-w-md px-5 flex-1 flex flex-col items-center justify-center relative z-10 my-4">
        
        <!-- ENVELOPE VIEW -->
        <div id="envelope-section" class="w-full flex flex-col items-center cursor-pointer transition-transform duration-500 hover:scale-[1.02]" onclick="openLetter()">
            <div class="w-full bg-love-800/80 backdrop-blur-xl border border-rose-500/30 rounded-3xl p-8 glow-box text-center relative overflow-hidden flex flex-col items-center shadow-2xl">
                <!-- Decorative stamp/seal -->
                <div class="w-16 h-16 rounded-full bg-gradient-to-br from-rose-500 to-rose-700 flex items-center justify-center text-white shadow-lg mb-6 border border-rose-300/40 relative">
                    <i class="fa-solid fa-heart text-2xl"></i>
                    <div class="absolute inset-0 rounded-full animate-ping opacity-25 bg-rose-400"></div>
                </div>

                <h2 class="serif-font text-2xl text-rose-200 font-semibold mb-2">A Message For You</h2>
                <p class="text-xs text-rose-300/70 tracking-wider uppercase mb-6">Tap to open your digital letter</p>

                <div class="w-full py-3 px-6 rounded-xl bg-gradient-to-r from-rose-600 to-rose-700 text-white font-medium text-sm shadow-md flex items-center justify-center gap-2 transition-all hover:brightness-110">
                    <span>Open Envelope</span>
                    <i class="fa-solid fa-envelope-open text-xs"></i>
                </div>
            </div>
        </div>

        <!-- LETTER VIEW (Hidden initially) -->
        <div id="letter-section" class="w-full hidden opacity-0 transition-all duration-700 transform translate-y-6">
            <div class="w-full bg-love-800/90 backdrop-blur-2xl border border-rose-500/40 rounded-3xl p-6 sm:p-8 glow-box relative shadow-2xl">
                
                <!-- Date stamp -->
                <div class="flex justify-between items-center border-b border-rose-500/20 pb-4 mb-5">
                    <span class="text-xs uppercase tracking-widest text-rose-400/80 font-semibold bg-love-700/60 px-3 py-1 rounded-full border border-rose-500/20">
                        <i class="fa-regular fa-calendar-days mr-1.5"></i> 08/10/2026
                    </span>
                    <button onclick="closeLetter()" class="text-rose-400/60 hover:text-rose-300 text-xs flex items-center gap-1 transition-colors">
                        <i class="fa-solid fa-rotate-left"></i> Re-seal
                    </button>
                </div>

                <!-- Letter Content -->
                <div class="serif-font text-lg sm:text-xl leading-relaxed text-rose-100/95 space-y-4 max-h-[55vh] overflow-y-auto pr-2 custom-scrollbar">
                    <p class="font-semibold text-rose-200 text-xl">
                        Ma Cheri !!!!!,
                    </p>
                    <p>
                        Hope i spelled that right, at this moment i am typing this now, you are probably sleeping like the bueaty you are, since i don't have work today and im tryna push myself to work on some music so ima just quickly type this out for you.
                    </p>
                    <p>
                        Anyways, i hope you have a good day today my love, whatever happens today, it all leads to something, be positive and keep doing good, im proud of what you have done at your job, your very talanted and hard working and you deserve the recognition your getting, remember you've worked long and hard for this so be gratful for it, even if we don't text or call as much as before im going to continue trying to starve and doing better for me and you, for a life were we both are together....just be patient bb <span class="inline-block text-base">😙</span>
                    </p>
                </div>

                <!-- Sign off -->
                <div class="mt-6 pt-4 border-t border-rose-500/20 flex flex-col">
                    <span class="serif-font italic text-rose-300 text-lg">Yours,</span>
                    <span class="font-semibold text-rose-100 tracking-wide text-base">Seif <span class="text-xs font-normal text-rose-400/85">(your freaky lover lmao)</span></span>
                </div>

                <!-- Quick actions / Music vibe footer -->
                <div class="mt-6 flex items-center justify-between bg-love-900/60 rounded-2xl p-3 border border-rose-500/20 text-xs text-rose-300/80">
                    <div class="flex items-center gap-2">
                        <div class="w-7 h-7 rounded-full bg-rose-500/20 flex items-center justify-center text-rose-400 animate-spin" style="animation-duration: 4s;">
                            <i class="fa-solid fa-music"></i>
                        </div>
                        <span class="italic font-serif">Working on music & thinking of you</span>
                    </div>
                    <button onclick="sendHeartReaction()" class="bg-rose-600 hover:bg-rose-500 text-white px-3 py-1.5 rounded-xl font-medium transition-all shadow-sm flex items-center gap-1 active:scale-95">
                        <i class="fa-solid fa-heart text-xs"><span> Send Love</span></i>
                    </button>
                </div>

            </div>
        </div>

    </main>

    <footer class="w-full py-4 text-center text-xs text-rose-400/50 z-10">
        Made with ❤️ by Seif for Tessa
    </footer>

    <script>
        // Floating ambient hearts generator
        function createHeartParticle() {
            const container = document.getElementById('particles-container');
            const heart = document.createElement('div');
            heart.classList.add('particle');
            
            const symbols = ['❤️', '✨', '💖', '🌹', '💕', '💫'];
            heart.innerHTML = symbols[Math.floor(Math.random() * symbols.length)];
            
            const startX = Math.random() * window.innerWidth;
            const size = Math.random() * 14 + 12; // 12px to 26px
            const duration = Math.random() * 6 + 5; // 5s to 11s
            const opacity = Math.random() * 0.5 + 0.3;
            
            heart.style.left = `${startX}px`;
            heart.style.fontSize = `${size}px`;
            heart.style.opacity = opacity;
            heart.style.animationDuration = `${duration}s`;
            
            container.appendChild(heart);
            
            setTimeout(() => {
                heart.remove();
            }, duration * 1000);
        }

        // Spawn initial particles
        for(let i = 0; i < 12; i++) {
            setTimeout(createHeartParticle, i * 400);
        }
        setInterval(createHeartParticle, 800);

        // Letter open transition
        function openLetter() {
            const envelope = document.getElementById('envelope-section');
            const letter = document.getElementById('letter-section');
            
            // Burst of extra hearts on open
            for(let i = 0; i < 8; i++) {
                setTimeout(createHeartParticle, i * 100);
            }

            envelope.style.transform = 'scale(0.9) translateY(20px)';
            envelope.style.opacity = '0';
            
            setTimeout(() => {
                envelope.classList.add('hidden');
                letter.classList.remove('hidden');
                // Trigger reflow for transition
                void letter.offsetWidth;
                letter.classList.remove('opacity-0', 'translate-y-6');
                letter.classList.add('opacity-100', 'translate-y-0');
            }, 300);
        }

        // Letter re-seal transition
        function closeLetter() {
            const envelope = document.getElementById('envelope-section');
            const letter = document.getElementById('letter-section');
            
            letter.classList.remove('opacity-100', 'translate-y-0');
            letter.classList.add('opacity-0', 'translate-y-6');
            
            setTimeout(() => {
                letter.classList.add('hidden');
                envelope.classList.remove('hidden');
                envelope.style.transform = 'scale(1) translateY(0)';
                envelope.style.opacity = '1';
            }, 300);
        }

        // Interactive Send Love Reaction
        function sendHeartReaction() {
            for(let i = 0; i < 15; i++) {
                setTimeout(createHeartParticle, i * 80);
            }
            
            // Show custom floating notification
            const notification = document.createElement('div');
            notification.className = 'fixed top-6 left-1/2 transform -translate-x-1/2 bg-rose-600 text-white px-4 py-2 rounded-2xl shadow-xl z-50 text-sm font-medium animate-bounce flex items-center gap-2';
            notification.innerHTML = '<i class="fa-solid fa-heart"><span>Love sent to Seif! ❤️</span></i>';
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.transition = 'opacity 0.5s ease';
                notification.style.opacity = '0';
                setTimeout(() => notification.remove(), 500);
            }, 2500);
        }
    </script>
</body>
</html>
